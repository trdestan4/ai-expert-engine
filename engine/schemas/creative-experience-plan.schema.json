{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-expert-engine.local/schemas/creative-experience-plan.schema.json",
  "title": "Creative Experience Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","experience","responsive","motion","performance","fallbacks","qa"],
  "properties": {
    "version": {"const": 1},
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creative_thesis","signature_moments"],
      "properties": {
        "creative_thesis": {"type":"string","minLength":8},
        "signature_moments": {"type":"array","maxItems":3,"items":{"type":"string","minLength":3}}
      }
    },
    "responsive": {
      "type":"object",
      "additionalProperties": false,
      "required":["desktop","mobile"],
      "properties": {
        "desktop":{"type":"string","minLength":3},
        "mobile":{"type":"string","minLength":3},
        "tablet":{"type":"string"}
      }
    },
    "motion": {
      "type":"object",
      "additionalProperties": false,
      "required":["technologies","scroll_control","reduced_motion"],
      "properties": {
        "technologies":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "scroll_control":{"enum":["native","native-with-triggers","not-applicable"]},
        "reduced_motion":{"type":"string","minLength":8}
      }
    },
    "graphics3d": {
      "type":"object",
      "additionalProperties": false,
      "required":["enabled","fallback","lifecycle_disposal"],
      "properties": {
        "enabled":{"type":"boolean"},
        "fallback":{"type":"string","minLength":3},
        "lifecycle_disposal":{"type":"boolean"},
        "asset_pipeline":{"type":"string"},
        "dpr_cap":{"type":"number","exclusiveMinimum":0,"maximum":4}
      }
    },
    "performance": {
      "type":"object",
      "additionalProperties": false,
      "required":["target_devices","budgets","measurement"],
      "properties": {
        "target_devices":{"type":"array","minItems":2,"items":{"type":"string"}},
        "budgets":{"type":"object","minProperties":1},
        "measurement":{"type":"string","minLength":8}
      }
    },
    "fallbacks": {
      "type":"object",
      "additionalProperties": false,
      "required":["javascript_failure","advanced_effect_failure"],
      "properties": {
        "javascript_failure":{"type":"string","minLength":3},
        "advanced_effect_failure":{"type":"string","minLength":3},
        "no_webgl":{"type":"string"}
      }
    },
    "qa": {
      "type":"object",
      "additionalProperties": false,
      "required":["viewports","states","visual_authority","baseline_policy"],
      "properties": {
        "viewports":{"type":"array","minItems":2,"items":{"type":"string"}},
        "states":{"type":"array","minItems":2,"items":{"type":"string"}},
        "visual_authority":{"type":"string","minLength":3},
        "baseline_policy":{"type":"string","minLength":8}
      }
    }
  }
}
