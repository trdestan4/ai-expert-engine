{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AI Expert Engine Runtime Telemetry",
  "type":"object",
  "required":["timestamp","task_id","event","complexity","risk","primary_skill","supporting_skills","reviewers","activation_width","outcome"],
  "properties":{
    "timestamp":{"type":"string","minLength":1},
    "session_id":{"type":["string","null"]},
    "task_id":{"type":"string","minLength":1},
    "event":{"enum":["route","review","verify","release","checkpoint","eval"]},
    "complexity":{"enum":["C0","C1","C2","C3","C4"]},
    "risk":{"enum":["R0","R1","R2","R3","R4"]},
    "primary_skill":{"type":"string","minLength":1},
    "supporting_skills":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "reviewers":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "loaded_references":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "activation_width":{"type":"integer","minimum":1},
    "prompt_tokens":{"type":["integer","null"],"minimum":0},
    "completion_tokens":{"type":["integer","null"],"minimum":0},
    "context_tokens":{"type":["integer","null"],"minimum":0},
    "duration_ms":{"type":["integer","null"],"minimum":0},
    "outcome":{"enum":["success","failure","hold","no-go","unknown"]},
    "notes":{"type":["string","null"]}
  },
  "additionalProperties":false
}
