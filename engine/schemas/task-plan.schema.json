{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-expert-engine.local/schemas/task-plan.schema.json",
  "title": "Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "scope", "steps", "acceptanceCriteria"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "verification"],
        "properties": {
          "action": {"type": "string"},
          "verification": {"type": "array", "items": {"type": "string"}},
          "rollback": {"type": ["string", "null"]}
        }
      }
    },
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
